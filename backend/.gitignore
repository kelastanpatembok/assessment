target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml

# Gradle (if used)
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# IDE files
.idea/
.vscode/
*.iws
*.iml
*.ipr
.settings/
.project
.classpath
bin/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files
*.env
.env*
!.env.example
!.env.template

# Database containers/data
.postgres/
.mysql/
.mongodb/
db-data/

# Logs
logs/
*.log
log/
*.out

# Runtime data
pids/
*.pid
*.pid.lock

# Test reports and coverage
test-results/
surefire-reports/
failsafe-reports/
jacoco/
*.exec

# Application specific
storage/
storage-test/
backups/
data/
uploads/

# Temporary files
*.tmp
*.temp
.cache/

# Spring Boot
spring.log
application-*.properties
!application-*.example.properties

# H2 Database files
*.db
*.trace.db
*.lock.db

# JQwik database
.jqwik-database
